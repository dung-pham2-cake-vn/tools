{
  "name": "tools-management-system",
  "version": "1.0.0",
  "description": "Comprehensive tools management system with Jira integration, task/story point management, sprint management, and roadmap management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "dev:backend": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.0",
    "axios": "^1.4.0",
    "dotenv": "^16.0.3",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "joi": "^17.9.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/cors": "^2.8.13",
    "@types/morgan": "^1.9.5",
    "typescript": "^5.1.3",
    "ts-node": "^10.9.1",
    "eslint": "^8.44.0",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "prettier": "^2.8.8"
  }
}
