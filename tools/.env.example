# Server Configuration
PORT=3002
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/tools-management
MONGODB_USER=
MONGODB_PASSWORD=

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Jira Configuration
JIRA_HOST=https://your-domain.atlassian.net
JIRA_USERNAME=your_jira_email@example.com
JIRA_API_TOKEN=your_jira_api_token

# Logging
LOG_LEVEL=info

# Bot Telegram 2 chiều: nhận lệnh ghi note SVK qua chat (false để tắt)
TELEGRAM_BOT_ENABLED=true

# Sau khi AI review xong, tự comment kết quả lên chính ticket SVK (false để tắt)
SVK_AI_COMMENT=true
# true = comment nội bộ (chỉ agent thấy); false = khách hàng tạo ticket cũng đọc được
SVK_AI_COMMENT_INTERNAL=true

# Ảnh đính kèm gửi kèm prompt AI (0 = tắt). Chỉ nhận png/jpeg/gif/webp.
SVK_AI_IMAGE_LIMIT=4
SVK_AI_IMAGE_MAX_MB=4

# Số ticket AI review song song (1 = chạy tuần tự — proxy giới hạn concurrent request)
SVK_AI_CONCURRENCY=1

# AI provider "Claude Code (trên máy này)": đường dẫn CLI nếu `claude` không có trên PATH của backend
# CLAUDE_CODE_BIN=/Users/<you>/.nvm/versions/node/v24.15.0/bin/claude
CLAUDE_CODE_TIMEOUT_SEC=600
